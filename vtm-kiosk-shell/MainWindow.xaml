<Window x:Class="VtmKioskShell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VTM Kiosk"
        Width="1024" Height="768"
        WindowStartupLocation="CenterScreen"
        Background="#0b0d10"
        FontFamily="Segoe UI">

    <!--
        This window stands in for the bank's own kiosk application. Everything here is a
        placeholder except the two buttons and the status line, which are what a real kiosk
        would wire to TellerCall.
    -->
    <Grid Margin="48">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Welcome" Foreground="#f2f4f7" FontSize="34" FontWeight="SemiBold" />
            <TextBlock Text="This window is where your kiosk application goes."
                       Foreground="#9aa3ae" FontSize="15" Margin="0,6,0,0" />
        </StackPanel>

        <!-- Stand-in for the banking screens. -->
        <Border Grid.Row="1" Margin="0,32" CornerRadius="12" Background="#1a1e24">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Your screens"
                           Foreground="#6b7280" FontSize="15" HorizontalAlignment="Center" />
                <TextBlock Text="Accounts, transfers, forms — whatever the kiosk does."
                           Foreground="#4b5563" FontSize="13" Margin="0,8,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2">
            <!-- Shown whenever the teller is viewing this screen, beside the other controls, so
                 the customer can see it and stop it without hunting for the browser's own bar.
                 That bar still appears too: it is the browser's disclosure and is left alone. -->
            <Border x:Name="ShareIndicator" Visibility="Collapsed" Margin="0,0,0,14"
                    Background="#2a1215" BorderBrush="#e5484d" BorderThickness="1"
                    CornerRadius="8" Padding="14,10">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="Stop sharing" Click="OnStopShareClick"
                            Padding="18,8" FontSize="14" Background="#e5484d" Foreground="White"
                            BorderThickness="0" Cursor="Hand" />
                    <Ellipse Width="10" Height="10" Fill="#e5484d" Margin="0,0,10,0"
                             VerticalAlignment="Center" />
                    <TextBlock Text="Your screen is being shared with the teller"
                               Foreground="#f2f4f7" FontSize="15" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <TextBlock x:Name="Status" Text="Starting…"
                       Foreground="#9aa3ae" FontSize="15" Margin="0,0,0,14" />

            <StackPanel Orientation="Horizontal">
                <Button x:Name="TalkButton" Content="Talk to a teller"
                        Click="OnTalkClick" IsEnabled="False"
                        Padding="26,14" FontSize="16" Background="#2f6feb"
                        Foreground="White" BorderThickness="0" Cursor="Hand" />

                <Button x:Name="FinishButton" Content="I'm finished"
                        Click="OnFinishClick" Visibility="Collapsed"
                        Margin="12,0,0,0" Padding="26,14" FontSize="16"
                        Background="#e5484d" Foreground="White"
                        BorderThickness="0" Cursor="Hand" />

                <Button x:Name="RetryButton" Content="Try again"
                        Click="OnRetryClick" Visibility="Collapsed"
                        Padding="26,14" FontSize="16"
                        Background="#23282f" Foreground="#f2f4f7"
                        BorderThickness="0" Cursor="Hand" />

                <Button x:Name="AudioButton" Content="Tap to hear the teller"
                        Click="OnAudioClick" Visibility="Collapsed"
                        Margin="12,0,0,0" Padding="26,14" FontSize="16"
                        Background="#23282f" Foreground="#f2f4f7"
                        BorderThickness="0" Cursor="Hand" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
