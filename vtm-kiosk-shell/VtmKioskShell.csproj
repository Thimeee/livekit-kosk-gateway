<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>VtmKiosk</AssemblyName>
    <RootNamespace>VtmKioskShell</RootNamespace>

    <!-- Native AOT is off across this solution; the LiveKit SDK has reflection paths that fail
         silently under trimming (PROJECT.md D-003). Nothing here needs it either. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3485.44" />
  </ItemGroup>

  <ItemGroup>
    <!-- Settings live beside the exe so a branch can change the URL without a rebuild. -->
    <None Update="kiosk-shell.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Builds the kiosk page into webroot/, so `dotnet publish` produces a complete kiosk rather
    than an application that still needs someone to remember a second command.

    Only on publish: a `dotnet build` during development should not sit through an ng build,
    and a developer running the page from `ng serve` does not want a stale copy bundled.
    Skip it with /p:BuildKioskPage=false.
  -->
  <PropertyGroup>
    <KioskPageProject>$(MSBuildProjectDirectory)/../vtm-kiosk</KioskPageProject>
    <KioskPageDist>$(KioskPageProject)/dist/vtm-kiosk/browser</KioskPageDist>
    <BuildKioskPage Condition="'$(BuildKioskPage)' == ''">true</BuildKioskPage>
  </PropertyGroup>

  <Target Name="BuildKioskPage" BeforeTargets="PrepareForPublish"
          Condition="'$(BuildKioskPage)' == 'true'">

    <Error Condition="!Exists('$(KioskPageProject)/package.json')"
           Text="The kiosk page is not at $(KioskPageProject). Publish with /p:BuildKioskPage=false to skip bundling it." />

    <Message Importance="high" Text="Building the kiosk page..." />

    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(KioskPageProject)"
          Condition="!Exists('$(KioskPageProject)/node_modules')" />

    <Exec Command="npm run build" WorkingDirectory="$(KioskPageProject)" />

    <Error Condition="!Exists('$(KioskPageDist)/index.html')"
           Text="The kiosk page built but produced no index.html in $(KioskPageDist)." />
  </Target>

  <!--
    On an ordinary build, copy whatever the last Angular build produced into bin/webroot so the
    folder is runnable. No ng build here: that belongs to publish, and a developer pressing F5
    should not wait for one. A stale copy is worse than none, so this says which it used.
  -->
  <Target Name="StageKioskPage" AfterTargets="Build">
    <Warning Condition="!Exists('$(KioskPageDist)/index.html')"
             Text="No kiosk page at $(KioskPageDist) - bin/webroot will be empty. Run `npm run build` in vtm-kiosk, or use `dotnet publish`, which builds it for you." />

    <ItemGroup>
      <StagedPageFiles Include="$(KioskPageDist)/**/*" Exclude="$(KioskPageDist)/kiosk.secret" />
    </ItemGroup>

    <Copy Condition="Exists('$(KioskPageDist)/index.html')"
          SourceFiles="@(StagedPageFiles)"
          DestinationFiles="@(StagedPageFiles->'$(OutDir)webroot/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />

    <Message Condition="Exists('$(KioskPageDist)/index.html')" Importance="high"
             Text="Staged the kiosk page into $(OutDir)webroot (from the last Angular build)" />
  </Target>

  <Target Name="CopyKioskPage" AfterTargets="Publish"
          Condition="'$(BuildKioskPage)' == 'true'">

    <ItemGroup>
      <!--
        kiosk.secret is excluded deliberately. Angular copies public/ into dist/, so a secret
        left there for browser development would otherwise be bundled into every kiosk install.
        Under the shell the secret is injected from kiosk-shell.json and never travels with the
        page.
      -->
      <KioskPageFiles Include="$(KioskPageDist)/**/*" Exclude="$(KioskPageDist)/kiosk.secret" />
    </ItemGroup>

    <!-- PublishDir does not reliably end with a separator; without this the copy once landed
         in a folder called "publishwebroot". -->
    <PropertyGroup>
      <KioskWebRoot>$([MSBuild]::EnsureTrailingSlash('$(PublishDir)'))webroot</KioskWebRoot>
    </PropertyGroup>

    <Copy SourceFiles="@(KioskPageFiles)"
          DestinationFiles="@(KioskPageFiles->'$(KioskWebRoot)/%(RecursiveDir)%(Filename)%(Extension)')" />

    <Message Importance="high" Text="Bundled @(KioskPageFiles->Count()) files into webroot/" />
  </Target>

</Project>
